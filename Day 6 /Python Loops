# Day 6 - Python Loops

print("=== FOR LOOP ===")
for i in range(1, 6):
    print("Number:", i)

print("\n=== WHILE LOOP ===")
count = 1
while count <= 5:
    print("Count:", count)
    count += 1

print("\n=== BREAK EXAMPLE ===")
for i in range(1, 11):
    if i == 6:
        break
    print(i)

print("\n=== CONTINUE EXAMPLE ===")
for i in range(1, 11):
    if i == 5:
        continue
    print(i)
